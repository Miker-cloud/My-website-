{
  "name": "tarians-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Tarian's — international plant-based enterprise demo (Education + AI + Marketplace + LIVE). Investor-ready, locally runnable prototype with mock data.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tarians/web",
    "build": "npm run build --workspace @tarians/web",
    "start": "npm run start --workspace @tarians/web",
    "lint": "npm run lint --workspace @tarians/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
