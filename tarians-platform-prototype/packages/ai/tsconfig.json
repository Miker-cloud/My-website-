{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@tarians/types": ["../types/src/index.ts"],
      "@tarians/mock-data": ["../mock-data/src/index.ts"]
    }
  },
  "include": ["src"]
}
